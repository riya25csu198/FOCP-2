#include <iostream>

using namespace std;

void solve() {
    long long n;
    if (!(cin >> n)) return;
    
    if (n == 0) { // Specific case handling depending on constraints
        cout << 0 << "\n";
        return;
    }

    int k = 0;
    long long temp = n;
    
    // Standard prime factorization to count distinct factors
    for (long long i = 2; i * i <= temp; ++i) {
        if (temp % i == 0) {
            k++;
            while (temp % i == 0) temp /= i;
        }
    }
    if (temp > 1) k++;

    // The answer is 2 raised to the power of distinct prime factors
    cout << (1LL << k) << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}
